@page "/enforcement"
@inject PhishGuardApiClient Api
@inject AnalystIdentity Analyst

<PageTitle>Takedown notices · PhishGuard</PageTitle>

<div class="page-head">
    <div>
        <h1>Takedown notices</h1>
        <div class="muted">Drafted automatically for confirmed cases. Filing is simulated: approving marks a notice as filed and nothing is sent.</div>
    </div>
</div>

<div class="tabs">
    @foreach (var (value, label) in Tabs)
    {
        <button class="tab @(_status == value ? "active" : "")" @onclick="@(() => SwitchAsync(value))">@label</button>
    }
</div>

@if (_error is not null) { <div class="banner error">@_error</div> }
@if (_message is not null) { <div class="banner ok">@_message</div> }

@if (_page is null && _error is null)
{
    <div class="empty">Loading…</div>
}
else if (_page is not null && _page.Items.Count == 0)
{
    <div class="card empty">No notices here.</div>
}
else if (_page is not null)
{
    <div class="card table-wrap" style="padding:4px 6px">
        <table class="data">
            <thead><tr><th>Case</th><th>Domain</th><th>Route</th><th>Recipient</th><th>Status</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var n in _page.Items)
                {
                    <tr>
                        <td><a class="mono" href="cases/@n.CaseId">PG-@n.CaseId</a></td>
                        <td><span class="mono">@Display.Defang(n.Domain)</span><div class="muted small">@n.Brand</div></td>
                        <td>@n.Route</td>
                        <td class="small">@n.Recipient</td>
                        <td><Badge Text="@n.Status" Css="@Display.NoticeClass(n.Status)" /></td>
                        <td class="small muted">@n.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="actions">
                                <button class="btn btn-sm" @onclick="@(() => Toggle(n.Id))">@(_open.Contains(n.Id) ? "Hide" : "Preview")</button>
                                @if (n.Status == "Draft")
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="@(() => ActAsync(n.Id, true))">Approve &amp; file</button>
                                    <button class="btn btn-sm" disabled="@_busy" @onclick="@(() => ActAsync(n.Id, false))">Reject</button>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (_open.Contains(n.Id))
                    {
                        <tr><td colspan="7"><div class="notice"><strong>@n.Subject</strong><pre>@n.Body</pre></div></td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="pager">
        <button class="btn btn-sm" disabled="@(_page.Page <= 1)" @onclick="() => LoadAsync(_page.Page - 1)">Previous</button>
        <span class="muted small">@_page.Total.ToString("N0") notice(s) · page @_page.Page</span>
        <button class="btn btn-sm" disabled="@(_page.Page * _page.PageSize >= _page.Total)" @onclick="() => LoadAsync(_page.Page + 1)">Next</button>
    </div>
}

@code {
    private static readonly (string Value, string Label)[] Tabs = [("Draft", "Awaiting approval"), ("Filed", "Filed"), ("Rejected", "Rejected"), ("", "All")];

    private PagedResult<NoticeDto>? _page;
    private string _status = "Draft";
    private string? _error, _message;
    private bool _busy;
    private readonly HashSet<long> _open = [];

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private Task SwitchAsync(string status) { _status = status; _message = null; return LoadAsync(1); }

    private async Task LoadAsync(int page)
    {
        try { _page = await Api.GetNoticesAsync(_status, page); _error = null; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ActAsync(long id, bool approve)
    {
        _busy = true;
        try
        {
            if (approve) await Api.ApproveNoticeAsync(id, Analyst.Name); else await Api.RejectNoticeAsync(id, Analyst.Name);
            _message = approve ? "Notice marked as filed (simulated)." : "Notice rejected.";
            await LoadAsync(_page?.Page ?? 1);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void Toggle(long id) { if (!_open.Remove(id)) _open.Add(id); }
}
