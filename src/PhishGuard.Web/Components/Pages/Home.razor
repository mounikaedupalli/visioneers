@page "/"
@rendermode InteractiveServer
@inject PhishGuardApiClient Api

<PageTitle>PhishGuard · Dataset</PageTitle>

<h1>PhishGuard</h1>
<p>Dataset overview. Campaigns, cases and the analyst queue come in later phases.</p>

@if (_error is not null)
{
    <p style="color:#b00020">Could not reach the API: @_error. Is the dataset loaded (run PhishGuard.DataGen)?</p>
}
else if (_stats is null)
{
    <p>Loading…</p>
}
else
{
    <div style="display:flex;gap:2rem;margin:1rem 0">
        <div><strong>@_stats.TotalUrls.ToString("N0")</strong><br />URLs</div>
        <div><strong>@_stats.PhishingUrls.ToString("N0")</strong><br />phishing (@((100.0 * _stats.PhishingUrls / Math.Max(1, _stats.TotalUrls)).ToString("F2"))%)</div>
        <div><strong>@_stats.DomainsWithEvidence.ToString("N0")</strong><br />domains with evidence</div>
    </div>

    <table style="border-collapse:collapse">
        <thead><tr><th style="text-align:left;padding:4px 12px">Category</th><th style="text-align:left;padding:4px 12px">Label</th><th style="text-align:right;padding:4px 12px">Count</th></tr></thead>
        <tbody>
            @foreach (var c in _stats.ByCategory)
            {
                <tr>
                    <td style="padding:4px 12px">@c.Category</td>
                    <td style="padding:4px 12px">@(c.IsPhishing ? "phishing" : "benign")</td>
                    <td style="padding:4px 12px;text-align:right">@c.Count.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DatasetStats? _stats;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _stats = await Api.GetStatsAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }
}
